# syntax=docker/dockerfile:1
# Module 02c - Distroless runtime: no shell, no package manager -> tiny attack surface.
# Trade-off: you cannot `docker exec ... sh`, and HEALTHCHECK with wget/curl is not possible
# (use orchestrator probes on /actuator/health instead).
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml .
RUN --mount=type=cache,target=/root/.m2 mvn -B -q dependency:go-offline
COPY src ./src
RUN --mount=type=cache,target=/root/.m2 mvn -B -q package -DskipTests

FROM gcr.io/distroless/java21-debian12:nonroot
WORKDIR /app
COPY --from=build /build/target/app.jar app.jar
EXPOSE 8080
# The distroless java image already has ENTRYPOINT ["java","-jar"]; CMD is the jar path
CMD ["/app/app.jar"]
